```gitignore
# ==========================================
# IntelliJ IDEA
# ==========================================
.idea/
*.iml
*.ipr
*.iws
out/

# ==========================================
# Java / Spring Boot / Maven
# ==========================================
**/target/
**/build/
**/out/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Maven Wrapper - keep wrapper files tracked
# .mvn/wrapper/
# mvnw
# mvnw.cmd

# ==========================================
# Next.js
# ==========================================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.turbo/

# Next.js deployment output
frontend/.vercel/

# ==========================================
# Node.js / npm / yarn / pnpm
# ==========================================
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# Package manager caches
**/.npm/
**/.yarn/cache/
**/.pnp.*

# ==========================================
# Environment variables and secrets
# ==========================================
.env
.env.*
!.env.example
!.env.sample

# Spring Boot configuration containing secrets
**/application-local.properties
**/application-local.yml
**/application-local.yaml
**/application-secret.properties
**/application-secret.yml
**/application-secret.yaml

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# ==========================================
# Logs
# ==========================================
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==========================================
# Test Reports and Coverage
# ==========================================
**/surefire-reports/
**/failsafe-reports/
**/test-results/
**/coverage/
frontend/coverage/
.nyc_output/

# ==========================================
# Temporary Files
# ==========================================
*.tmp
*.temp
*.swp
*.swo
*.bak
*~

# ==========================================
# Docker / Local Infrastructure
# ==========================================
# Ignore local environment overrides
.env.docker
docker-compose.override.yml

# ==========================================
# IDE / Debugger
# ==========================================
.vscode/
*.sln.docstates

# ==========================================
# Local Database Files
# ==========================================
*.sqlite
*.sqlite3
*.db

# ==========================================
# Gradle (if any backend service uses Gradle)
# ==========================================
**/.gradle/

# ==========================================
# Next.js TypeScript
# ==========================================
frontend/next-env.d.ts

# ==========================================
# Local Development Files
# ==========================================
*.local
```
